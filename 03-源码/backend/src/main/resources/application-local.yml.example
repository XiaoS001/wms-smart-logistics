# ============================================================
#  本地开发配置示例
#
#  使用方法：
#    1. 复制本文件为同目录下的 application-local.yml
#    2. 把 password 改成你本机的真实数据库密码
#    3. application-local.yml 已被 .gitignore 排除，不会进入版本库
#
#  启动命令：
#    mvn spring-boot:run -Dspring-boot.run.profiles=local
#    或 java -jar wms-1.0.0.jar --spring.profiles.active=local
# ============================================================

spring:
  datasource:
    username: wms
    # ↓↓↓ 改成你本机的真实密码 ↓↓↓
    password: 在此填写本机数据库密码

logging:
  level:
    com.lijunjie.wms: debug
